# Wrangler writes a cache here holding the Cloudflare account id and the
# account's display name (which contains an email address). Never commit it —
# wrangler recreates it in whatever directory it is run from.
.wrangler/
**/.wrangler/

# Editor and OS noise
.DS_Store
Thumbs.db
*.log
*.swp

# Not used today, but wrangler will pull these in if the project ever grows
node_modules/

# Note: artifact.html and public/index.html ARE committed on purpose. They are
# generated by build.sh, but they are also the deployable product — a fresh
# clone can publish without running anything first.
